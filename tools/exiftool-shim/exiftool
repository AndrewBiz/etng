#!/usr/bin/env python3
"""exiftool compatibility shim for phtools integration.

Read calls are passed to etng.  Write calls generated by phtools as
`exiftool -@ script` are translated to etng assignments.  The shim logs every
command to ETNG_SHIM_LOG (default: stderr).

Environment:
  ETNG_BIN                 path to etng (default: etng from PATH)
  REAL_EXIFTOOL            absolute fallback (default: /usr/bin/exiftool)
  ETNG_SHIM_LOG            log file, or "-" for stderr
  ETNG_SHIM_FALLBACK       "1" to fall back to exiftool on failed reads
  ETNG_SHIM_WRITE_FALLBACK "1" to fall back to exiftool for whole write scripts
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ETNG = os.environ.get("ETNG_BIN") or shutil.which("etng") or "etng"
REAL_EXIFTOOL = os.environ.get("REAL_EXIFTOOL") or shutil.which("exiftool") or "/usr/bin/exiftool"
LOG = os.environ.get("ETNG_SHIM_LOG", "-")
READ_FALLBACK = os.environ.get("ETNG_SHIM_FALLBACK", "0") == "1"
WRITE_FALLBACK = os.environ.get("ETNG_SHIM_WRITE_FALLBACK", "0") == "1"

ALIASES = {
    "DATETIMEORIGINAL": "DateTimeOriginal",
    "CREATEDATE": "CreateDate",
    "MODIFYDATE": "ModifyDate",
    "ALLDATES": "AllDates",
    "FILEMODIFYDATE": "FileModifyDate",
    "CITY": "City",
    "COUNTRY": "Country",
    "STATE": "State",
    "LOCATION": "Location",
    "KEYWORDS": "Keywords",
    "CREATOR": "Creator",
    "COPYRIGHT": "Copyright",
    "COUNTRYCODE": "CountryCode",
    "LOCATIONSHOWNCOUNTRYCODE": "CountryCode",
    "WORLDREGION": "WorldRegion",
    "LOCATIONSHOWNWORLDREGION": "WorldRegion",
    "CODEDCHARACTERSET": "CodedCharacterSet",
    "IMAGEUNIQUEID": "ImageUniqueID",
    "GPSLATITUDE": "GPSLatitude",
    "GPSLATITUDEREF": "GPSLatitudeRef",
    "GPSLONGITUDE": "GPSLongitude",
    "GPSLONGITUDEREF": "GPSLongitudeRef",
    "GPSALTITUDE": "GPSAltitude",
    "GPSALTITUDEREF": "GPSAltitudeRef",
}

IGNORED_WRITE_OPTIONS = {
    "OVERWRITE_ORIGINAL",
    "IGNOREMINORERRORS",
    "V0",
    "V1",
    "P",
    "Q",
    "M",
    "EXECUTE",
    "PRESERVE",
}


def log(message: str) -> None:
    if LOG == "-":
        print(f"exiftool-shim: {message}", file=sys.stderr)
    else:
        with open(LOG, "a", encoding="utf-8") as stream:
            stream.write(message + "\n")


def run(command: list[str], *, stdin: bytes | None = None) -> subprocess.CompletedProcess:
    log("run: " + " ".join(command))
    return subprocess.run(command, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def passthrough_read(args: list[str]) -> int:
    result = run([ETNG, *args])
    if result.returncode != 0 and READ_FALLBACK and Path(REAL_EXIFTOOL).exists():
        log("etng read failed; falling back to exiftool")
        real = run([REAL_EXIFTOOL, *args])
        sys.stdout.buffer.write(real.stdout)
        sys.stderr.buffer.write(real.stderr)
        return real.returncode
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    return result.returncode


def split_option(text: str) -> tuple[str, str | None, str]:
    """Return (name, modifier, value); modifier is '', '-', '+', or '<'."""
    raw = text[1:] if text.startswith("-") else text
    if "<" in raw:
        name, value = raw.split("<", 1)
        return name, "<", value
    for marker in ("-=", "+="):
        if marker in raw:
            name, value = raw.split(marker, 1)
            return name, marker[0], value
    if "=" in raw:
        name, value = raw.split("=", 1)
        return name, "", value
    return raw, "", ""


def canonical_tag(name: str) -> str | None:
    last = name.split(":")[-1]
    return ALIASES.get(last.upper())


def collections_value(value: str) -> str | None:
    value = value.strip()
    if value.startswith("{"):
        value = value[1:]
    if value.endswith("}"):
        value = value[:-1]
    match = re.search(r"CollectionName\s*=\s*(.*?),?\s*CollectionURI\s*=\s*(.*?)\s*$", value)
    if not match:
        return None
    name, uri = match.group(1).strip(), match.group(2).strip()
    return f"{name}|{uri}"


def translate_script(path: Path) -> int:
    text = path.read_text(encoding="utf-8", errors="replace")
    tags: list[tuple[str, str]] = []
    collections: list[str] = []
    keywords: list[str] = []
    creators: list[str] = []
    copy_file_date = False
    current_file: str | None = None
    failed = False

    def flush() -> bool:
        nonlocal tags, collections, keywords, creators, copy_file_date, current_file
        if current_file is None:
            tags, collections, keywords, creators, copy_file_date = [], [], [], [], False
            return True
        args = [f"-{name}={value}" for name, value in tags]
        args += [f"-Collections={value}" for value in collections]
        args += [f"-Keywords={value}" for value in keywords]
        args += [f"-Creator={value}" for value in creators]
        if copy_file_date:
            date = next((value for name, value in tags if name == "DateTimeOriginal"), None)
            if date is None:
                read = run([ETNG, "-j", "-G1", "-DateTimeOriginal", current_file])
                if read.returncode != 0:
                    sys.stderr.buffer.write(read.stderr)
                    return False
                try:
                    import json

                    date = json.loads(read.stdout.decode("utf-8"))[0]["ExifIFD:DateTimeOriginal"]
                except Exception:
                    log(f"cannot read DateTimeOriginal from {current_file}")
                    return False
            args.append(f"-FileModifyDate={date}")
        if not tags and not collections and not keywords and not creators and not copy_file_date:
            tags, collections, keywords, creators, copy_file_date = [], [], [], [], False
            current_file = None
            return True
        args.append(current_file)
        result = run([ETNG, *args])
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        ok = result.returncode == 0
        tags, collections, keywords, creators, copy_file_date = [], [], [], [], False
        current_file = None
        return ok

    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if not line.startswith("-"):
            current_file = line
            continue
        name, modifier, value = split_option(line)
        upper = name.upper()
        if upper == "EXECUTE":
            failed |= not flush()
            continue
        if upper in IGNORED_WRITE_OPTIONS:
            continue
        if upper == "FILEMODIFYDATE" and modifier == "<":
            copy_file_date = True
            continue
        if upper == "FILEMODIFYDATE" and modifier == "":
            tags.append(("FileModifyDate", value))
            continue
        if upper.endswith("MWG-COLL:COLLECTIONS") or upper == "COLLECTIONS":
            parsed = collections_value(value) if modifier != "-" else None
            if parsed:
                collections.append(parsed)
            continue
        tag = canonical_tag(name)
        if tag is None:
            log(f"unsupported write tag {name!r} in {path}")
            failed = True
            continue
        if tag == "Keywords":
            if modifier == "+":
                keywords.append(value)
            elif modifier == "":
                keywords.append(value)
            continue
        if tag == "Creator":
            if modifier in ("+", ""):
                creators.append(value)
            continue
        if modifier == "-":
            continue
        tags.append((tag, value))

    if current_file is not None:
        failed |= not flush()
    if failed and WRITE_FALLBACK and Path(REAL_EXIFTOOL).exists():
        log("write translation failed; falling back to exiftool")
        result = run([REAL_EXIFTOOL, "-@", str(path)])
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        return result.returncode
    return 1 if failed else 0


def main(argv: list[str]) -> int:
    if not argv:
        return passthrough_read(argv)
    if argv[0] in ("-ver", "--version"):
        return passthrough_read(argv)
    if "-@" in argv:
        index = argv.index("-@")
        if index + 1 >= len(argv):
            print("exiftool-shim: -@ requires a script path", file=sys.stderr)
            return 2
        return translate_script(Path(argv[index + 1]))
    return passthrough_read(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
